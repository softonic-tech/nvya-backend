# Stripe → Developers → API keys (sk_test_... while testing, sk_live_... in production)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Your website: customers return here after paying or cancelling, and only it may call this API
HOME_URL=https://your-domain.com

# Comma-separated ISO country codes you ship to
SHIPPING_COUNTRIES=AU
# Flat shipping in cents (0 = free shipping)
SHIPPING_FLAT_CENTS=0

PORT=4000
